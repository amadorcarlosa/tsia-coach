{
  "openapi": "3.2.0",
  "info": {
    "title": "tsia-coach.Server | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/models": {
      "get": {
        "tags": [
          "Models"
        ],
        "operationId": "GetModels",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FoundryDeploymentResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/agents/{agentName}/invoke": {
      "post": {
        "tags": [
          "Agents"
        ],
        "operationId": "InvokeAgent",
        "parameters": [
          {
            "name": "agentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvokeAgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvokeAgentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/weatherforecast": {
      "get": {
        "tags": [
          "tsia-coach.Server"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FoundryDeploymentResponse": {
        "required": [
          "id",
          "modelName",
          "modelVersion",
          "displayName",
          "provider",
          "lifecycle",
          "supportedApis",
          "operations",
          "inputModalities",
          "outputModalities",
          "features",
          "interactionModes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "modelName": {
            "type": "string"
          },
          "modelVersion": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/ModelProvider"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/ModelLifecycle"
          },
          "supportedApis": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelApi"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelOperation"
            }
          },
          "inputModalities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelModality"
            }
          },
          "outputModalities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelModality"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelFeature"
            }
          },
          "interactionModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InteractionMode"
            }
          }
        }
      },
      "InteractionMode": {
        "enum": [
          "RequestResponse",
          "Streaming",
          "Realtime"
        ]
      },
      "InvokeAgentRequest": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "InvokeAgentResponse": {
        "required": [
          "replyText",
          "inputTokens",
          "outputTokens",
          "latencyMs",
          "responseId"
        ],
        "type": "object",
        "properties": {
          "replyText": {
            "type": "string"
          },
          "inputTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "outputTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "latencyMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "responseId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ModelApi": {
        "enum": [
          "Responses",
          "ChatCompletions",
          "Embeddings",
          "AnthropicMessages",
          "Realtime",
          "Audio"
        ]
      },
      "ModelFeature": {
        "enum": [
          "ToolCalling",
          "StructuredOutput",
          "Reasoning",
          "FileInput",
          "ComputerUse",
          "JsonOutput"
        ]
      },
      "ModelLifecycle": {
        "enum": [
          "GenerallyAvailable",
          "Preview",
          "Legacy",
          "Deprecated"
        ]
      },
      "ModelModality": {
        "enum": [
          "Text",
          "Image",
          "Audio",
          "Video"
        ]
      },
      "ModelOperation": {
        "enum": [
          "Chat",
          "Embedding",
          "SpeechToText",
          "TextToSpeech"
        ]
      },
      "ModelProvider": {
        "enum": [
          "OpenAI",
          "Anthropic",
          "DeepSeek",
          "Google",
          "Microsoft"
        ]
      },
      "WeatherForecast": {
        "required": [
          "date",
          "temperatureC",
          "summary"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "temperatureF": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Agents"
    },
    {
      "name": "Models"
    },
    {
      "name": "tsia-coach.Server"
    }
  ]
}